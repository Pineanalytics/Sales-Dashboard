# Public Supabase browser configuration. These two values are safe to expose to
# the browser, but the service role key and the bridge key below are server-only.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Pinefrost Analytics is the authoritative source for this app's reference
# projection. Keep this value server-side and use the production HTTPS URL.
ANALYTICS_REFERENCE_URL="https://pinefrostdb.com"
# Must match COACHING_REFERENCE_SYNC_KEY in Pinefrost Analytics exactly.
COACHING_REFERENCE_SYNC_KEY=""
