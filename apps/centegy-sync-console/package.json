{
  "name": "pinefrost-centegy-sync-console",
  "version": "1.0.0",
  "private": true,
  "description": "Local operator console for Pinefrost Sales & Returns sync on a Centegy PC.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ke.co.pinefrost.centegy-sync-console",
    "productName": "Pinefrost Centegy Sync Console",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "renderer/**/*", "scripts/**/*", "config.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
