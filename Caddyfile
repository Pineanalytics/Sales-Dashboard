# Migration plan Step 7: DOMAIN is now the real domain (pinefrostdb.com),
# so Caddy automatically requests and renews a real Let's Encrypt certificate
# and serves HTTPS — no manual TLS config needed.
#
# Reverse-proxies to "pinefrost-app-1" (the container's own name), not the
# Compose service alias "app" — field-forms-app (below) was later joined to
# this same Docker network under an alias that ALSO resolves to "app",
# so Docker's embedded DNS returned either container ambiguously for that
# hostname and this domain intermittently served the wrong app. The
# container's own name has no such collision.
{$DOMAIN} {
	reverse_proxy pinefrost-app-1:3000
}

# Keep the apex hostname canonical while still serving a valid certificate for
# users and links that include www. Caddy obtains and renews this hostname's
# certificate automatically before issuing the permanent redirect.
www.pinefrostdb.com {
	redir https://pinefrostdb.com{uri} permanent
}

# field-forms app (Latitude / Pinefrost multi-tenant forms), added alongside
# the main pinefrost site. Same-origin routing sends Supabase client paths to
# the self-hosted gateway; all other requests go to the Next.js forms app.
# Keeping this in the tracked configuration means the production watchdog does
# not need to replace the Caddyfile after a dashboard deployment.
app.pinefrostdb.com {
	@supabase path /rest/v1/* /auth/v1/* /storage/v1/*
	handle @supabase {
		reverse_proxy field-forms-supabase-kong:8000
	}
	handle {
		reverse_proxy field-forms-app:3000
	}
}

# Self-hosted team file share. This remains independently served through the
# shared proxy and must be retained whenever the dashboard is released.
files.pinefrostdb.com {
	redir /.well-known/carddav /remote.php/dav 301
	redir /.well-known/caldav /remote.php/dav 301

	reverse_proxy nextcloud-app:80 {
		header_up X-Forwarded-Proto {scheme}
	}
}
