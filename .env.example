# Postgres connection strings. In production these are assembled by
# docker-compose.yml from POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB (the VPS's
# own Postgres container, not reachable from outside it — see README's Deploying
# section) — you don't set them directly there. For local dev, point both at a
# Postgres you control; no pooler/pgbouncer is needed for a single-node instance.
DATABASE_URL="postgresql://user:password@localhost:5432/pinefrost"
DIRECT_URL="postgresql://user:password@localhost:5432/pinefrost"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-32-byte-base64-secret"

# Optional: lets a headless script call POST /api/upload without an interactive admin
# session (e.g. a scheduled export from the source Excel workbook). Sent as the
# x-upload-api-key header. Leave unset to disable this auth path entirely.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
UPLOAD_API_KEY=""

# Private server-to-server credential used only by the Coaching reference-data
# bridge. It is sent in the x-coaching-reference-key header; never expose it
# with a NEXT_PUBLIC_ prefix or reuse UPLOAD_API_KEY.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
COACHING_REFERENCE_SYNC_KEY=""

# Required for the AI Insights feature (/api/ai-insights/generate, the Q&A chat,
# and AI-written report narratives). Get a key at console.anthropic.com — must
# also be set in the VPS's own .env for the deployed app to use it.
ANTHROPIC_API_KEY=""

# Optional: only needed to run scripts/db-bridge (shadow-validation SQL bridge, not used
# by the running app). Dedicated read-only SQL Server login for PINEFROSTSERVER/GVS_PL_DB.
# Only reachable from the office LAN, so this only works run from that machine.
SQLBRIDGE_SQL_SERVER="PINEFROSTSERVER"
SQLBRIDGE_SQL_PORT="1433"
SQLBRIDGE_SQL_DATABASE="GVS_PL_DB"
SQLBRIDGE_SQL_USER=""
SQLBRIDGE_SQL_PASSWORD=""
SQLBRIDGE_SQL_ENCRYPT="false"
SQLBRIDGE_SQL_TRUST_SERVER_CERT="true"

# Optional: only needed to run scripts/db-bridge/coverage (shadow-validation only, not
# used by the running app). A MySQL database (NOT SQL Server) backing a separate
# field-force/SFA system, unrelated to SQLBRIDGE_SQL_* above.
SQLBRIDGE_COVERAGE_MYSQL_HOST=""
SQLBRIDGE_COVERAGE_MYSQL_PORT="3306"
SQLBRIDGE_COVERAGE_MYSQL_USER=""
SQLBRIDGE_COVERAGE_MYSQL_PASSWORD=""
SQLBRIDGE_COVERAGE_MYSQL_DATABASE=""

# Optional: only used by scripts/pl-bridge/run.ts (npm run pl:sync) to know where to
# POST live P&L data. Reuses SQLBRIDGE_SQL_* for the SQL Server connection and
# UPLOAD_API_KEY above for auth — this just overrides the target app URL if needed.
# Defaults to https://pinefrostdb.com when unset.
PL_BRIDGE_APP_URL=""

# Optional: EABL Call Performance source. This is the SQL Server source in
# PINEFR_1.PQ, intentionally separate from the Pine MySQL timestamp bridge.
# Use the read-only pinefrost_dms login; never reuse another bridge's account.
EABL_CALL_SQL_SERVER="187.77.80.216"
EABL_CALL_SQL_PORT="1433"
EABL_CALL_SQL_DATABASE="PinefrostAnalytics"
EABL_CALL_SQL_USER=""
EABL_CALL_SQL_PASSWORD=""
EABL_CALL_SQL_ENCRYPT="false"
EABL_CALL_SQL_TRUST_SERVER_CERT="true"
# Blank means the production dashboard URL. Set only for a non-production test target.
EABL_CALL_APP_URL=""
# Set temporarily (YYYY-MM-DD) to replay history, then remove it. Normal sync rebuilds two days.
EABL_CALL_BACKFILL_FROM=""

# Existing FastAPI DSR dashboard used by the authenticated EABL DSR Review.
# Production Docker reaches the service through the VPS host gateway.
EABL_DSR_REVIEW_URL="http://172.18.0.1:8000"

# Optional: only needed to run scripts/db-bridge/sales-returns (the scheduled
# `sales-returns:sync` job). Sales & Returns invoice-line detail source — the
# Centegy DMS's CASHMEMO/DSR/POP/SKU tables, a separate SQL Server instance from
# both SQLBRIDGE_SQL_* (SAP) and EABL_CALL_SQL_* (PinefrostAnalytics). Typically
# a named instance on the same Windows machine the Task Scheduler job runs on
# (e.g. Data Source=.\sndpro in the source system's own connection string) —
# set SALES_RETURNS_SQL_SERVER="." and SALES_RETURNS_SQL_INSTANCE to the
# instance name in that case; leave SALES_RETURNS_SQL_INSTANCE unset and use
# SALES_RETURNS_SQL_PORT for a plain host+port connection instead. Dedicated
# read-only login — never reuse another bridge's.
SALES_RETURNS_SQL_SERVER=""
SALES_RETURNS_SQL_INSTANCE=""
SALES_RETURNS_SQL_PORT="1433"
SALES_RETURNS_SQL_DATABASE=""
SALES_RETURNS_SQL_USER=""
SALES_RETURNS_SQL_PASSWORD=""
SALES_RETURNS_SQL_ENCRYPT="false"
SALES_RETURNS_SQL_TRUST_SERVER_CERT="true"
# Optional: only used by scripts/db-bridge/sales-returns/run.ts to know where to
# POST. Reuses UPLOAD_API_KEY above for auth. Defaults to https://pinefrostdb.com.
SALES_RETURNS_APP_URL=""
# Set temporarily (YYYY-MM-DD) to force a manual backfill from that delivery
# date through yesterday, then remove it. Routine five-minute Smart mode finds
# and repairs changed/missing days automatically.
SALES_RETURNS_BACKFILL_FROM=""
# Required by both routine Smart sync and the manual trigger poll. This
# machine's own branch distributor code, matching SalesReturnLine's
# storageLocation (Nairobi "18048241", Nyeri "18058585").
SALES_RETURNS_DISTRIBUTOR=""
# Number of SQL delivery days Smart mode compares with the VPS every five
# minutes. Defaults to 35; accepted range is 2-62.
SALES_RETURNS_RECONCILE_DAYS="35"

# Private server-to-server credential for the SAP vendor's real-time sales pull
# (app/api/integrations/sap/sales-export). Sent as the x-sap-sales-key header.
# Reuses the EABL_CALL_SQL_* connection above (same PinefrostAnalytics database,
# same read-only pinefrost_dms login) — this is a new auth key only, no new DB creds.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SAP_SALES_EXPORT_KEY=""

# Private credential for the headerless EABL daily CSV endpoint
# (app/api/integrations/eabl/sales-export). It uses the existing read-only
# EABL_CALL_SQL_* PinefrostAnalytics connection; this is a dedicated download
# credential, never a SQL password. Install the same value as the machine-level
# EABL_SALES_EXPORT_KEY only on the dedicated download machine.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EABL_SALES_EXPORT_KEY=""

# Private server-to-server credential for the UKL Sales & Returns CSV export
# (app/api/integrations/ukl/sales-export), pulled daily by
# scripts/ukl-sales-export-pull.ps1 running on the server that hosts
# D:\UKL_INTEGRATION\UPLOADS (a separate machine from both the app and the
# Centegy DMS SQL Server bridge). Sent as the x-ukl-export-key header. Reads
# from SalesReturnLine — no new DB creds needed here either.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
UKL_SALES_EXPORT_KEY=""

# Private server-to-server credential for app/api/pipeline-alerts — the
# failure-only email hook for the two standalone scripts
# above that have no SMTP credentials of their own: run.ts on the Centegy
# machine and scripts/ukl-sales-export-pull.ps1 on the
# D:\UKL_INTEGRATION\UPLOADS server. Same value must also be set as a plain
# PIPELINE_ALERT_KEY variable in those two machines' own .env / machine-level
# environment (see UKL_SALES_EXPORT_KEY's setup for the machine-level pattern).
# Sent as the x-pipeline-alert-key header. Requires SMTP_USER/SMTP_PASSWORD
# below to actually be configured — unset on either end just skips the alert.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PIPELINE_ALERT_KEY=""
# Optional: who receives those pipeline alert emails. Defaults to
# analytics@pinefrost.co.ke.
PIPELINE_ALERT_EMAIL=""

# Optional: enables the "your account has been approved" notification email
# (lib/email.ts, sent from /admin/users' Approve button) via info@pinefrostdb.com's
# own SMTP. Leave SMTP_USER/SMTP_PASSWORD unset to disable — approvals still work, the
# email is just skipped (logged as a warning).
SMTP_HOST=""                # defaults to smtp.gmail.com — set to your mailbox provider's SMTP host
SMTP_PORT=""                # defaults to 465
SMTP_USER=""                # info@pinefrostdb.com
SMTP_PASSWORD=""            # that mailbox's SMTP password (an App Password if it's Gmail-hosted)
SMTP_FROM_NAME=""           # defaults to "Pinefrost Limited Performance Dashboard"

# Optional: the login link included in that approval email. Defaults to
# https://pinefrostdb.com when unset (same default as PL_BRIDGE_APP_URL above).
APP_URL=""

# --- Self-hosted VPS deployment (docker-compose.yml) ---
# This app deploys only to the self-hosted VPS now (Netlify/Supabase fully retired —
# see README's Deploying section). On the VPS, this .env file lives at the repo root
# (never committed) and is loaded by Docker Compose directly — DATABASE_URL/DIRECT_URL
# above are NOT set there, docker-compose.yml assembles them from these three so the
# Postgres password only lives in one place.
POSTGRES_USER=""
POSTGRES_PASSWORD=""
POSTGRES_DB=""
# The domain Caddy requests an HTTPS certificate for (see Caddyfile). Leave
# unset / point at the VPS's bare IP for pre-cutover staging verification.
DOMAIN=""
