// Prisma schema for the Sales Performance Dashboard.
// Postgres (Supabase), connected via the pooled connection for app queries
// and the direct connection for migrations/db push (see .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Snapshot {
  id          String   @id @default(cuid())
  uploadedAt  DateTime @default(now())
  reportTitle String
  data        String // JSON-serialized Dataset (see lib/types.ts)

  @@index([uploadedAt])
}

enum Role {
  ADMIN
  VIEWER
  TEAM_LEADER
  // Sits above TEAM_LEADER: sees/edits every TeamLeaderAssignment row under the
  // Team Leaders in their own Supervisor group (see TeamLeaderAssignment.supervisorId),
  // same CRUD breadth ADMIN has on /admin/team-leaders, just scoped. Introduced for
  // the Sales Supervisor tier — see lib/teamLeaderScope.ts's loadSupervisorScope.
  SUPERVISOR
  // Head of Sales — fills their own company-wide PerformanceTracker (type=HOD)
  // each period. Company-wide by design (no linked entity, unlike TEAM_LEADER/
  // SUPERVISOR): there's one HOD tracker per period, not one per person.
  // Unscoped like ADMIN — resolveScopeForSession only special-cases SUPERVISOR/
  // TEAM_LEADER/VIEWER, so HOD (and DIRECTOR) already fall through to null
  // (unrestricted) with no changes needed there.
  HOD
  // Reviews/views every HOD tracker (read + reviewComments/status only, never
  // fills KPI values themselves) — the MD/Director tier the HOD tracker was
  // built to be presented to. Also company-wide/unscoped, same reasoning as HOD.
  DIRECTOR
}

enum UserStatus {
  PENDING
  APPROVED
}

model User {
  id                String     @id @default(cuid())
  email             String     @unique
  name              String?
  passwordHash      String
  role              Role       @default(VIEWER)
  status            UserStatus @default(APPROVED) // admin-created users are pre-approved; self-registered rows start PENDING
  allowedPages      String[]   @default([]) // report page keys this user can see; ignored for ADMIN (always full access)
  teamLeaderId      String?    @unique // links a TEAM_LEADER-role login to their TeamLeader row; unused for ADMIN/VIEWER
  supervisorId      String?    @unique // links a SUPERVISOR-role login to their Supervisor row; unused otherwise, mirrors teamLeaderId
  // Restricts a VIEWER-role login to specific principals (Cost Centres) across the whole
  // app — dataset, every Prisma-backed dashboard/report route, and Frost — the same
  // scoping mechanism a TEAM_LEADER already gets via teamLeaderId, just principal-only
  // (no rep/employeeCode identity of their own). Empty = unrestricted, matching this
  // project's "default-all-pages on approval" convention: an existing VIEWER's access
  // never narrows just because this field shipped. Unused for ADMIN/TEAM_LEADER.
  allowedPrincipals String[]   @default([])
  createdAt         DateTime   @default(now())
}

// Admin-editable content for automated emails (currently just the new-modules
// announcement — see lib/email.ts's ANNOUNCEMENT_TEMPLATE_KEY). One row per
// email "key". Absence of a row (first run, or after "Reset to original")
// means the caller falls back to that email's DEFAULT_*_SUBJECT/BODY
// constants in lib/email.ts rather than erroring.
model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  subject   String
  body      String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// Admin-maintained monthly targets, uploaded via a small dedicated form
// (app/(protected)/admin/targets) independent of the big Sales/Stock/Coverage
// refresh cycle. Overlaid onto Dataset.monthlySales[].target at read time by
// lib/datasetStore.ts, not baked into the Snapshot JSON blob at upload time.
model Target {
  id                 String   @id @default(cuid())
  year               String
  month              String
  monthIndex         Int
  principal          String
  mainPrincipal      String?
  valueTarget        Float?
  volumeTarget       Float?
  coverageTarget     Float?
  productivityTarget Float?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@unique([year, month, principal])
  @@index([year, month])
}

// One row per edit made through the Monthly Targets entry form (app/(protected)/
// admin/targets), mirroring the source Target_Per_Principal_System.xlsm workbook's
// AuditTrail sheet. `changes` holds { field: { old, new } } for whichever of the
// 4 target fields moved in that save — not written by the bulk-upload path, only
// the row-level Add/Edit/Delete form.
model TargetAuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  userEmail String
  action    String // "CREATE" | "UPDATE" | "DELETE"
  year      String
  month     String
  principal String
  changes   Json

  @@index([year, month, principal])
}

// Team Leader roster — one row per team leader, optionally linked to a login
// (User.teamLeaderId) once they have one. Admin-editable via /admin/team-leaders.
// supervisorId is the reporting line used by TL Ranking's Manager/Supervisor
// rollup (lib/tlRanking.ts's buildSupervisorRanking) — an HR fact about the
// Team Leader, not about any one principal they happen to head, so it lives
// here rather than being duplicated (and risking disagreement) across every
// Principal row. Replaced resolving this from TeamLeaderAssignment rows
// (rep-level, array-order-dependent, confirmed unreliable — see
// buildSupervisorRanking's own comment). Admin-editable via
// app/(protected)/admin/team-leaders.
model TeamLeader {
  id           String   @id @default(cuid())
  name         String   @unique
  supervisorId String?
  createdAt    DateTime @default(now())

  coveringReliefs     TeamLeaderRelief[]   @relation("CoveringReliefs")
  coveredReliefs      TeamLeaderRelief[]   @relation("CoveredReliefs")
  performanceTrackers PerformanceTracker[]
}

// "Benson relieves Calvince" / "Benson holds fort for Calvince" — a peer Team
// Leader granted temporary access to another Team Leader's own scope
// (principals/reps/coverage), admin- or supervisor-allocated. Deliberately a
// separate mechanism from TeamLeader.supervisorId (a permanent reporting-
// line fact): relief is temporary, symmetric between two peers rather than a
// hierarchy, and one Team Leader can cover several others (or be covered by
// several, one after another) over time, so the full history stays here
// rather than overwriting a single "currently relieving" field.
// "Currently active" = revokedAt IS NULL AND startDate <= now AND (endDate IS
// NULL OR endDate >= now) — see lib/teamLeaderScope.ts's getActiveReliefs.
// Deliberately not recursive: loadTeamLeaderScope unions in a covered Team
// Leader's own base scope only (their assignments/supervised reps), not
// anyone *they* might in turn be covering for — a two-hop relief chain is an
// edge case not worth the cycle-safety complexity it would add.
model TeamLeaderRelief {
  id                   String    @id @default(cuid())
  coveringTeamLeaderId String // the Team Leader granted temporary access (e.g. Benson)
  coveredTeamLeaderId  String // the Team Leader being relieved (e.g. Calvince)
  startDate            DateTime  @default(now())
  endDate              DateTime? // null = indefinite, until manually ended via revokedAt
  revokedAt            DateTime? // manual early end, independent of a planned endDate
  notes                String? // e.g. "Calvince on annual leave"
  createdByUserId      String? // audit: which admin/supervisor allocated this
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  covering TeamLeader @relation("CoveringReliefs", fields: [coveringTeamLeaderId], references: [id], onDelete: Cascade)
  covered  TeamLeader @relation("CoveredReliefs", fields: [coveredTeamLeaderId], references: [id], onDelete: Cascade)

  @@index([coveringTeamLeaderId])
  @@index([coveredTeamLeaderId])
}

// One row per Sales Supervisor — a tier above Team Leader (several Team Leaders
// report to one Supervisor, e.g. Mars-Nairobi's 5 Team Leaders all under Lucy
// Githinji). Mirrors TeamLeader exactly, including the find-or-create-by-name
// upsert pattern in lib/rosterImport.ts. Optionally linked to a login via
// User.supervisorId. Sourced from the Roster's "Sales Supervisor" column —
// deliberately a separate, FK-based mechanism from the older, fuzzier
// EmployeeMaster.supervisor name-matching in lib/teamLeaderScope.ts
// (teamLeaderSupervisesName), which stays untouched.
// managerId is this Supervisor's own reporting line up to Manager — same
// reasoning as TeamLeader.supervisorId above.
model Supervisor {
  id        String   @id @default(cuid())
  name      String   @unique
  managerId String?
  createdAt DateTime @default(now())
}

// One row per Manager — a tier above Supervisor (e.g. Angela Sitati oversees
// Lucy Githinji's Mars-Nairobi group plus several other Supervisors/principals).
// Reporting/ranking dimension only for now: no login role, no User.managerId.
// A real model (not a free-text column) for the same name-drift-safety reason
// TeamLeader/Supervisor are: it's a grouping/ranking key, not just display text.
model Manager {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

enum PerformanceTrackerType {
  HOD
  TEAM_LEADER
}

// Built from two real review workbooks, transcribed field-for-field: HEAD OF
// SALES REVIEW-Suntory.xlsx's "MD Performance Review" sheet (HOD type) and
// Sales Perfomance Tracker-Suntory.xlsx's "Monthly KPIs" + "Rep Scorecard"
// sheets (TEAM_LEADER type). One row per (type, period, teamLeaderId-or-null):
// the HOD tracker is company-wide (teamLeaderId null, one per period, filled
// by the HOD role, reviewed by DIRECTOR); the Team Leader tracker is one per
// Team Leader per period (filled by TEAM_LEADER, reviewed by their own
// SUPERVISOR via TeamLeaderAssignment.supervisorId — the same scope already
// used everywhere else). See lib/performanceTracker/definitions.ts for the
// per-type section/metric list (labels, weights, which metrics auto-populate
// from live data vs stay manual-only for other departments to fill in) and
// lib/performanceTracker/scoring.ts for the weighted-score/grade formulas,
// both transcribed from those workbooks' own Instructions tabs.
model PerformanceTracker {
  id                 String                 @id @default(cuid())
  type               PerformanceTrackerType
  periodMonth        String // "2026-08"
  teamLeaderId       String? // null for HOD; required for TEAM_LEADER
  teamLeader         TeamLeader?            @relation(fields: [teamLeaderId], references: [id], onDelete: Cascade)
  reviewedByName     String? // free text — matches the Excel form's "Reviewed by" field
  // HOD only — the MD's 0-5% qualitative addition (Instructions: "MD assigns
  // 0-5% based on qualitative assessment. Not in formula - add manually to
  // score if desired"). Genuinely not derivable from any metric.
  mdDiscretionaryPct Float?
  status             String                 @default("draft") // draft | submitted | reviewed
  reviewComments     String?
  createdByUserId    String?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  metrics PerformanceTrackerMetric[]
  repRows PerformanceTrackerRepRow[]

  @@unique([type, periodMonth, teamLeaderId])
  @@index([type, periodMonth])
}

// One row per KPI line within a tracker. metricKey matches a key in
// lib/performanceTracker/definitions.ts's per-type metric list; target/actual
// are null until filled in — manually, or by the auto-populate pass for
// whichever metrics have a live source (see that file's `autoSource` field).
// Deliberately rows-not-columns (unlike most models in this schema) because
// both source workbooks are themselves just growing lists of KPI/Target/
// Actual lines — "add relevant fields... add additional if need be" needs no
// migration this way, only a definitions.ts edit.
model PerformanceTrackerMetric {
  id        String             @id @default(cuid())
  trackerId String
  tracker   PerformanceTracker @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  metricKey String
  target    Float?
  actual    Float?
  updatedAt DateTime           @updatedAt

  @@unique([trackerId, metricKey])
}

// Team Leader tracker only — one row per sales rep on that Team Leader's team
// for the period, mirroring "Rep Scorecard"'s per-rep grid: Volume, Revenue,
// LPPC (a distribution-breadth proxy — see that sheet's own weighting),
// Calls/Strike Rate, and a lightweight OOS aggregate (audited/instances,
// rather than the source workbook's full outlet×SKU audit log, which was
// scoped out of this first pass). Weighted score/grade are computed on read
// from these fields (lib/performanceTracker/scoring.ts's computeRepScore),
// never stored, so they always reflect the latest inputs.
model PerformanceTrackerRepRow {
  id              String             @id @default(cuid())
  trackerId       String
  tracker         PerformanceTracker @relation(fields: [trackerId], references: [id], onDelete: Cascade)
  employeeCode    String? // links to EmployeeMaster where resolvable; free-text repName always shown regardless
  repName         String
  territory       String?
  channel         String?
  volumeTarget    Float?
  volumeActual    Float?
  revenueTarget   Float?
  revenueActual   Float?
  lppcTarget      Float?
  lppcActual      Float?
  callsPlanned    Float?
  callsMade       Float?
  productiveCalls Float?
  oosAudited      Float? // outlets audited this period — denominator for OOS Rate
  oosInstances    Float? // of those, how many were found out-of-stock
  sortOrder       Int                @default(0)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([trackerId])
}

// The "fact table" driving Weekly Targets: which reps, selling which principals,
// report up through which team leader. Admin-editable via /admin/team-leaders.
// A rep can appear under multiple principals, and (matrix orgs) under different
// team leaders per principal. This table is the source of truth for which
// (teamLeaderId, principal) pairs get a Weekly Target grid, and which reps are
// eligible for that principal's RepContribution split.
model TeamLeaderAssignment {
  id                    String   @id @default(cuid())
  teamLeaderId          String
  employeeCode          String
  employeeName          String
  principal             String
  // Below: ported from Target_Management_System.xlsm's Roster sheet.
  channel               String? // free text, e.g. "KA" — matches the workbook's free-text Channel column
  // The Roster's "SAP Name" column — the rep's name as it appears in SAP, distinct from
  // employeeName (the "Employee (Sales Edge Name)" column, the Pine-side name). This is the
  // actual join key for matching rep-level revenue from the Excel-sourced Brand&Customer sheet
  // (MonthlyBrandCustomerRow.salesEmployee is a SAP-side name string) back to a Team Leader —
  // the Pine/SAP name-mismatch problem this project has hit before. Read from the source
  // workbook on the original Roster import but not persisted until now.
  sapName               String?
  // Admin-declared allocation %, distinct from RepContribution.sharePct (which is computed from
  // actual trailing revenue). Null = not yet declared for this rep/principal — falls back to the
  // computed share. When set, must sum to ~100% across active reps per principal (validated in
  // the admin UI, not enforced at the DB level).
  contributionPct       Float?
  // Soft-remove flag — the normal way to take a rep off a principal (preserves WeeklyTarget/
  // DailyTarget/RepContribution history and this row's own audit trail). Hard delete still
  // exists for genuine mistakes.
  active                Boolean  @default(true)
  salesRole             String   @default("PRIMARY") // "PRIMARY" | "SECONDARY" — everyone PRIMARY for now
  // Below: ported from the updated Target_Management_System.xlsm's Roster sheet
  // (2026-08-03 refresh — 21 columns, up from the original 12-column import).
  // region/subRegion are Team-Leader-editable (their own reps only, see
  // targets-overview/actions.ts); the rest are reference data re-synced only by
  // re-running scripts/target-management/import.ts, not inline-editable — keeps
  // the Roster from drifting from the authoritative HR/ops source between imports.
  region                String?
  subRegion             String?
  // Free text, from the Roster's original "Supervisor" column — confirmed unused by
  // any application logic (superseded below by supervisorId, the FK-based mechanism
  // the new Sales Supervisor tier actually uses). Left as-is, not read anywhere.
  supervisor            String?
  workGroup             String?
  company               String?
  costCenter            String?
  absolutePrincipal     String?
  costCenterCount       Int?
  salesPoint            String?
  route                 String?
  location              String?
  sourceContributionPct Float? // the Roster's own un-normalized "Source Contribution %" basis
  // Below: from the 2026-08 Roster refresh's "Sales Supervisor"/"Manager"/"Stock Point"
  // columns (the first roster to carry them). String id-by-convention, same non-@relation
  // pattern as teamLeaderId above — resolved by find-or-create-by-name on import
  // (lib/rosterImport.ts), same as TeamLeader already works. Nullable: not every historical
  // row has been through a Sales Supervisor-aware import yet.
  supervisorId          String?
  managerId             String?
  stockPoint            String?
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  @@unique([teamLeaderId, employeeCode, principal])
  @@index([teamLeaderId])
  @@index([principal])
  @@index([region])
  @@index([supervisorId])
  @@index([managerId])
}

model TeamLeaderAssignmentAuditLog {
  id           String   @id @default(cuid())
  timestamp    DateTime @default(now())
  userEmail    String
  action       String // "CREATE" | "UPDATE" | "DEACTIVATE" | "REACTIVATE" | "DELETE"
  teamLeaderId String
  supervisorId String? // denormalized snapshot at the time of the edit, for a Supervisor's own scoped audit view without a live join back to (possibly since-changed) TeamLeaderAssignment
  principal    String
  employeeCode String
  changes      Json

  @@index([teamLeaderId, principal])
}

// Admin-editable reference data (rarely changes), consumed by scripts/db-bridge
// as the item->principal/pack-size join for the SQL bridge, replacing the
// earlier network-share Excel read.
model Product {
  id             String   @id @default(cuid())
  itemNo         String   @unique
  itemDescription String?
  series         String?
  size           String?
  packSize       Float?
  principal      String
  costPrice      Float?
  classification String?
  ssuConversion  Float?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

// Principal KPI workspace — an additive, fiscal-calendar-aware layer for
// principal-specific scorecards.  The company-wide `Target`, `Product`, and
// `EmployeeMaster` tables intentionally remain the shared sources for the
// standard dashboards; these tables retain the source dimensions and targets
// required where a principal (beginning with Mars) operates to a different
// period calendar and KPI definition.
model PrincipalKpiPeriod {
  id         String   @id @default(cuid())
  principal  String
  fiscalYear String
  periodKey  String // P01 … P13
  periodNo   Int
  startDate  DateTime
  endDate    DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([principal, fiscalYear, periodKey])
  @@index([principal, fiscalYear, periodNo])
}

model PrincipalKpiProduct {
  id             String   @id @default(cuid())
  principal      String
  itemNo         String
  itemName       String
  packSize       Float?
  brand          String?
  classification String?
  ssuConversion  Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([principal, itemNo])
  @@index([principal, brand])
}

// Kept separate from EmployeeMaster because this is a principal's commercial
// roster view (FSR, seller type and active days), not a replacement for the
// company-wide HR/Pine/SAP identity master.
model PrincipalKpiRoster {
  id            String   @id @default(cuid())
  principal     String
  employeeCode  String
  employeeName  String
  employeeGroup String?
  location      String?
  teamLeader    String?
  fsr           String?
  sellerType    String?
  activeDays    Int?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([principal, employeeCode])
  @@index([principal, sellerType])
}

model PrincipalKpiTarget {
  id             String   @id @default(cuid())
  principal      String
  fiscalYear     String
  periodKey      String
  periodNo       Int
  employeeCode   String
  employeeName   String?
  employeeGroup  String?
  location       String?
  teamLeader     String?
  fsr            String?
  sellerType     String?
  volumeTarget   Float?
  valueTarget    Float?
  universeTarget Float?
  coverageTarget Float?
  ssuTarget      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([principal, fiscalYear, periodKey, employeeCode])
  @@index([principal, fiscalYear, periodNo])
}

// Productive Report is a separate, SKU-level target model supplied by Mars.
// It is deliberately not folded into the sales-value target: its target is
// the number of productive outlet/SKU combinations expected from each rep.
model PrincipalKpiProductiveTarget {
  id            String   @id @default(cuid())
  principal     String
  employeeCode  String
  employeeName  String?
  employeeGroup String?
  location      String?
  fsr           String?
  itemName      String
  brand         String?
  universe      Float?
  targetRate    Float?
  targetOutlets Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([principal, employeeCode, itemName])
  @@index([principal, location, employeeGroup])
}

// Absolute route-to-market customer assignment.  Unlike a sales line, this
// also retains customers with no activity, which is required for the RTM
// universe, coverage and conversion KPIs in the Mars template.
model PrincipalKpiRtmCustomer {
  id           String   @id @default(cuid())
  principal    String
  customerId   String
  customerName String?
  location     String?
  territory    String?
  rtmType      String?
  assignedRep  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([principal, customerId])
  @@index([principal, location, rtmType])
}

// One source sales line.  It preserves the item, seller and fiscal-period
// context that the general ActiveOutletEvent ledger intentionally collapses.
// The `sourceKey` is deterministic on import/sync, making replacement feeds
// safe to retry without double-counting.
model PrincipalKpiSaleLine {
  id              String   @id @default(cuid())
  principal       String
  // Workbook imports remain a recoverable baseline while a direct principal
  // feed is being established.  The dashboard only reads PINE after a full
  // FY25/FY26 backfill has completed, so an interrupted source job cannot
  // produce a half-live scorecard.
  source          String   @default("WORKBOOK")
  sourceKey       String
  // Mirrors the Mars raw extract: sales/orders and their returns must remain
  // separately traceable so SSU can be reported net while productivity only
  // counts positive, sellable activity.
  transactionType String   @default("sale")
  saleType        String   @default("Actual")
  isReturn        Boolean  @default(false)
  fiscalYear      String
  periodKey       String
  periodNo        Int
  date            DateTime
  employeeCode    String?
  employeeName    String?
  employeeGroup   String?
  location        String?
  teamLeader      String?
  fsr             String?
  sellerType      String?
  customerId      String
  customerName    String?
  channel         String?
  rtmType         String?
  rtmOwner        String?
  territory       String?
  itemNo          String?
  itemName        String?
  brand           String?
  classification  String?
  qty             Float
  cases           Float
  ssu             Float
  revenue         Float
  invoiceNo       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([principal, sourceKey])
  @@index([principal, fiscalYear, periodNo])
  @@index([principal, source, fiscalYear, periodNo])
  @@index([principal, source, fiscalYear, periodNo, sellerType])
  @@index([principal, fiscalYear, customerId])
  @@index([principal, fiscalYear, brand])
}

// Admin-editable reference data (rarely changes), consumed by scripts/db-bridge
// as the warehouse->location join for the SQL bridge.
model Warehouse {
  id            String   @id @default(cuid())
  warehouseCode String   @unique
  warehouseName String
  location      String
  locationCode  String
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

// Admin-editable reference data, replacing the formerly-static
// scripts/db-bridge/reference/principals.json — the Warehouse->Location +
// Product->Principal resolution used throughout scripts/db-bridge (see
// applyFixups/YTD_RAW_FIXUPS in transform/buildMonthlySales.ts and its
// siblings) AND, via teamLeaderId, which Team Leader "heads" a principal for
// TL Ranking's revenue attribution (lib/tlRanking.ts) — replacing rep-name
// matching, which broke down whenever SAP's own rep bookkeeping didn't match
// the org roster (the Erick/Richard EABL-Nyeri/Nyahururu case). teamLeaderId
// is id-by-convention, same non-@relation pattern as
// TeamLeaderAssignment.teamLeaderId/supervisorId/managerId.
model Principal {
  id            String   @id @default(cuid())
  principal     String   @unique
  mainPrincipal String
  location      String
  locationCode  String?
  status        String   @default("Active") // "Active" | "Past"
  teamLeaderId  String? // null for "Past"/unowned principals
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@index([teamLeaderId])
}

// Admin-editable reference data (rarely changes). Not currently consumed by
// scripts/db-bridge's transforms or any dashboard view — kept for completeness
// alongside Product/Warehouse.
model KeyAccountRep {
  id         String   @id @default(cuid())
  rep        String   @unique
  channel    String
  teamLeader String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

// Monthly Sales (Revenue/COGS/Gross Profit) sourced directly from SAP SQL Server
// (scripts/db-bridge, YTD_Raw), pushed live via app/api/sales/upload. Unlike
// Target/PLEntry, this fully REPLACES Dataset.monthlySales at read time rather
// than merging a single field — once rows exist here, the Excel-sourced Sales
// figures in the Snapshot blob are no longer used (Target still overlays on top,
// same as before). Coverage/Brand&Customer/Stock/Weekly Projection remain
// Excel-sourced; this table intentionally covers Sales only.
model SalesRecord {
  id          String   @id @default(cuid())
  year        String
  month       String
  monthIndex  Int
  location    String
  principal   String
  revenue     Float
  cogs        Float
  grossProfit Float
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([year, month, principal])
  @@index([year, month])
}

// Day-grain sibling of SalesRecord — same SAP source (scripts/db-bridge/queries/
// dailySalesRaw.ts, a parallel query to ytdRaw.ts that doesn't collapse the real
// per-transaction TaxDate), same Product/Warehouse/Principal join
// (buildDailySales.ts), but kept as its own table rather than adding a `date`
// column to SalesRecord — SalesRecord's grain and unique key are month-level and
// already relied upon elsewhere; this exists specifically to give the Executive
// Overview's Week 1-4 / Daily Projection cards real actuals to compare against,
// not to replace the monthly pipeline. Only ever holds a bounded trailing window
// (see sales-sync.ts), not the whole year.
model DailySalesActual {
  id          String   @id @default(cuid())
  date        DateTime
  location    String
  principal   String
  revenue     Float
  cogs        Float
  grossProfit Float
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([date, principal, location])
  @@index([date])
  @@index([principal])
}

// Latest complete stock snapshot from the direct SAP bridge.  This deliberately
// sits beside (rather than inside) Snapshot: Excel remains the dashboard source
// while the direct feed is reconciled, so a partial or materially different SAP
// result can never overwrite the user-visible stock position.
model StockActual {
  id            String   @id @default(cuid())
  sourceDate    DateTime
  principal     String
  item          String
  itemCode      String
  openingVolume Float
  openingPcs    Float
  openingValue  Float
  rrWeekValue   Float
  rrWeekVolume  Float
  daysCover     Float
  action        String
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  @@unique([principal, item])
  @@index([sourceDate])
  @@index([principal])
}

// Zero-value stock positions with no invoice activity for the trailing three
// months. Kept separate from StockActual so the operational Stock Balance page
// stays actionable, while the historical/dormant exposure remains visible in
// its own review module.
model DormantStockActual {
  id           String    @id @default(cuid())
  sourceDate   DateTime
  principal    String
  item         String
  itemCode     String
  openingPcs   Float
  openingValue Float
  lastSaleDate DateTime?
  updatedAt    DateTime  @updatedAt
  createdAt    DateTime  @default(now())

  @@unique([principal, item])
  @@index([principal])
  @@index([lastSaleDate])
}

// Immutable audit of every complete direct SAP stock refresh.  The comparison
// fields are measured against the most recent Excel Dataset snapshot at the
// time of upload, giving Admin a visible, reviewable switch-over decision.
model StockSyncRun {
  id                    String   @id @default(cuid())
  sourceDate            DateTime
  completedAt           DateTime @default(now())
  rowCount              Int
  physicalSourceRows    Int
  demandSourceRows      Int
  matchedDemandRows     Int
  dormantOutOfStockRows Int      @default(0)
  excelSnapshotId       String?
  excelRowCount         Int?
  matchedExcelRows      Int?
  onlySapRows           Int?
  onlyExcelRows         Int?
  excelStockValue       Float?
  directStockValue      Float?
  stockValueVariancePct Float?

  @@index([completedAt])
}

// Canonical Calls & Productivity rows sourced directly from Pine.  The bridge
// uses the same cost-centre attribution rules as the former workbook query,
// but stores one immutable business grain (month/principal/role/rep) instead
// of requiring a refreshed Excel snapshot to serve coverage history.
model CoverageActual {
  id              String   @id @default(cuid())
  year            String
  month           String
  monthIndex      Int
  salesRole       String
  employeeName    String
  principal       String
  coverage        Int
  productiveCalls Int
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([year, monthIndex, salesRole, employeeName, principal])
  @@index([year, monthIndex])
  @@index([principal, year, monthIndex])
}

// Canonical employee master imported from the Employee Roaster workbook. Pine's
// Sales Rep Name and SAP's Sales Rep Name are intentionally both retained: Pine
// drives operational activity (coverage, productivity, JPA, timestamps), while
// SAP is the source of truth for transaction value and volume. `absolutePrincipal`
// is deliberately sourced only from the Employee Roaster sheet.
model EmployeeMaster {
  id                String   @id @default(cuid())
  employeeCode      String   @unique
  company           String?
  pineName          String
  sapName           String
  absolutePrincipal String
  salesRole         String
  workGroup         String?
  region            String?
  subRegion         String?
  teamLeader        String?
  supervisor        String?
  active            Boolean  @default(true)
  costCenterCount   Int?
  salesPoint        String?
  route             String?
  location          String?
  importedAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  contributions EmployeePrincipalContribution[]

  @@index([absolutePrincipal])
  @@index([active])
  @@index([sapName])
}

// A rep may be operationally rostered to one absolute principal yet contribute
// to more than one principal. This sheet is the source of truth for JPA/target
// eligibility; it is intentionally separate from EmployeeMaster.absolutePrincipal
// so Timestamp reporting cannot be reassigned by a contribution allocation.
model EmployeePrincipalContribution {
  id              String   @id @default(cuid())
  employeeId      String
  principal       String
  salesRole       String
  contributionPct Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee EmployeeMaster @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, principal])
  @@index([principal])
  @@index([employeeId])
}

// Rep-grain SAP actuals. These are generated only from SAP invoice/credit-note
// transactions and carry both the SAP salesperson name and the resolved Pine
// employee identity. Rows without a master match are retained with a null
// employeeCode so unmatched SAP revenue is never silently discarded.
model SalesRepActual {
  id           String   @id @default(cuid())
  year         String
  month        String
  monthIndex   Int
  location     String
  principal    String
  sapName      String
  employeeCode String?
  employeeName String?
  // Cases = SAP invoice/credit-note Quantity (piece-denominated) / OITM.NumInBuy,
  // computed at sync time in scripts/db-bridge/transform/buildRepSales.ts. Not
  // raw SAP Quantity — verified live that Quantity is piece-denominated on
  // ~99.97% of real invoice lines regardless of the item's nominal Sales UOM.
  cases        Float    @default(0)
  revenue      Float
  cogs         Float
  grossProfit  Float
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([year, month, principal, sapName])
  @@index([principal, year, month])
  @@index([employeeCode, year, month])
}

// Day-grain companion to SalesRepActual. It supports operational drill-downs
// without changing the existing DailySalesActual principal-level feed.
model DailySalesRepActual {
  id           String   @id @default(cuid())
  date         DateTime
  location     String
  principal    String
  sapName      String
  employeeCode String?
  employeeName String?
  // See SalesRepActual.cases — same conversion, day grain.
  cases        Float    @default(0)
  revenue      Float
  cogs         Float
  grossProfit  Float
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([date, principal, sapName])
  @@index([date, principal])
  @@index([employeeCode, date])
}

// Customer-grain SAP sales actuals, pushed live by scripts/db-bridge/sales-sync.ts
// (queries/ytdRaw.ts + transform/buildRepSales.ts's buildMonthlyCustomerSales) via
// app/api/sales/upload-brand-customer. Overlaid onto Dataset.monthlyBrandCustomer at
// read time by lib/datasetStore.ts's overlayBrandCustomer, replacing the Excel-sourced
// "Brand&Customer Listing" sheet for the current calendar year — same merge pattern as
// SalesRecord/overlaySales above. sapName is the raw SAP salesperson name (not resolved
// against the Employee Roaster) since MonthlyBrandCustomerRow.salesEmployee is itself
// documented as a SAP-side name, resolved to Team Leader later via
// TeamLeaderAssignment.sapName (see lib/tlRanking.ts).
model BrandCustomerActual {
  id           String   @id @default(cuid())
  year         String
  month        String
  monthIndex   Int
  principal    String
  brand        String   @default("Unspecified")
  sapName      String
  customerName String
  // See SalesRepActual.cases — same conversion, customer/brand grain.
  cases        Float    @default(0)
  revenue      Float
  grossProfit  Float
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([year, month, principal, brand, sapName, customerName])
  @@index([principal, year, month])
}

// Day-grain companion to BrandCustomerActual, built from queries/dailySalesRaw.ts
// + buildDailyCustomerSales — gives dataset.monthlyBrandCustomer real per-day dates
// for the current month, same role DailySalesRepActual plays for rep-grain data.
model DailyBrandCustomerActual {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  principal    String
  brand        String   @default("Unspecified")
  sapName      String
  customerName String
  // See SalesRepActual.cases — same conversion, customer/brand day grain.
  cases        Float    @default(0)
  revenue      Float
  grossProfit  Float
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([date, principal, brand, sapName, customerName])
  @@index([principal, date])
}

// P&L journal-entry lines from SAP (OJDT/JDT1 by Cost Centre/Account), pushed
// live by scripts/pl-bridge (not shadow-only, unlike scripts/db-bridge) via
// app/api/pl/upload. Aggregated to Year+Month+Principal+AccountCode+LineType
// grain before storage — never one row per raw JE line. Overlaid onto
// Dataset.monthlyPL at read time by lib/datasetStore.ts, same pattern as Target.
model PLEntry {
  id          String   @id @default(cuid())
  year        String
  month       String
  monthIndex  Int
  principal   String // Cost Centre — same raw Principal-Location string as MonthlySalesRow.principal
  accountCode String
  accountName String
  lineType    String // "REVENUE" | "COGS" | "EXPENSE" | "OTHER_INCOME"
  amount      Float
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([year, month, principal, accountCode, lineType])
  @@index([year, month])
}

// Active Outlets — outlet-level YTD purchase-event summary from the "pine"
// field-force DB, one row per Year+Principal+CustomerID, pushed live by
// scripts/db-bridge/active-outlets via app/api/active-outlets/upload. Read
// directly by app/(protected)/(analytics)/active-outlets/page.tsx — not part
// of Dataset/Snapshot, since this has no Excel-sourced equivalent. Powers
// outlet drill-down plus Channel/Sub Channel/Frequency-Band breakdowns,
// aggregated live from this table rather than pre-baked.
//
// timesBought/purchaseDays/activeMonths/sales/qty/firstPurchaseDate/
// lastPurchaseDate are DERIVED (a SQL aggregate over ActiveOutletEvent, see
// below) — not accumulated in-memory from a full YTD re-fetch every sync.
// status is set during the nightly full-recompute pass only (see
// SyncWatermark) — an outlet whose lastPurchaseDate has gone stale (60+
// days) flips to "Inactive"; incremental runs never touch this field.
model ActiveOutlet {
  id                 String   @id @default(cuid())
  year               String
  principal          String // Cost Centre, matches other principal fields' raw string
  customerId         String // pine.outlets o_id
  outletName         String
  channel            String
  subChannel         String
  territory          String
  latitude           Float?
  longitude          Float?
  pjpEmployeeCode    String?
  pjpRepName         String?
  pjpRepGroup        String?
  pjpRegion          String?
  salesRole          String // dominant role for the period: "Primary Sales" | "Secondary Sales"
  status             String   @default("Active") // "Active" | "Inactive"
  timesBought        Int
  purchaseDays       Int
  activeMonths       Int
  firstPurchaseDate  DateTime
  lastPurchaseDate   DateTime
  frequencyBand      String // e.g. "One-time Buyer", "Regular - About Monthly"
  sales              Float
  qty                Float
  mostRecentRep      String?
  mostRecentRepGroup String?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@unique([year, principal, customerId])
  @@index([year, principal])
}

// Append-only event ledger backing ActiveOutlet — one row per source
// sale/order document. This is the "parent data" incremental syncs append
// to (see scripts/db-bridge/active-outlets/run.ts); ActiveOutlet's summary
// fields are a SQL aggregate over this table, not an in-memory accumulation
// replayed from a full YTD MySQL re-fetch every run. Insert is always
// ON CONFLICT DO NOTHING on the unique key below — genuinely idempotent, so
// an incremental sync's deliberate fetch-window overlap (guards against
// Pine write-latency/clock skew) can never double-count an event.
//
// outletName/channel/subChannel/territory/salesRole/repName/repGroup are
// denormalized onto every event row (redundant across an outlet's many
// events, cheap at this scale) rather than looked up at derivation time —
// the upload route has no access to Pine's MySQL, only what the sync script
// already resolved and sent, so the ledger needs to be self-contained for
// the derivation query below to produce a complete ActiveOutlet row.
model ActiveOutletEvent {
  id              String   @id @default(cuid())
  year            String
  principal       String
  customerId      String
  docId           String // pine.sales/orders doc id
  isOrder         Boolean
  date            DateTime
  sales           Float
  qty             Float
  salesRole       String // "Primary Sales" | "Secondary Sales" — this event's own role
  outletName      String
  channel         String
  subChannel      String
  territory       String
  latitude        Float?
  longitude       Float?
  pjpEmployeeCode String?
  pjpRepName      String?
  pjpRepGroup     String?
  pjpRegion       String?
  repName         String?
  repGroup        String?
  createdAt       DateTime @default(now())

  @@unique([year, principal, customerId, docId, isOrder])
  @@index([year, principal, customerId])
  @@index([date])
}

// Tracks per-bridge sync progress so scripts/db-bridge/*/run.ts can decide
// full-vs-incremental mode instead of every scheduled run re-fetching a full
// source window. lastIncrementalAt is the newest source event timestamp
// incorporated so far (the fetch-since boundary, minus each bridge's own
// overlap buffer); lastFullResyncAt is when the last full/safety-net
// recompute completed — a run is forced into full mode once this is missing
// or older than ~22h, self-scheduling roughly one full pass a day without
// any time-of-day logic. One row per bridge ("active-outlets", "jp-adherence", ...).
model SyncWatermark {
  id                String    @id @default(cuid())
  bridge            String    @unique
  lastIncrementalAt DateTime
  lastFullResyncAt  DateTime?
  updatedAt         DateTime  @updatedAt
}

// Monthly trend for Active Outlets: distinct outlets per Cost Centre, split
// Primary/Secondary, RE-COUNTED per month — never derived by summing
// ActiveOutlet rows across months (same "unique not repeated sums" rule
// already established for Coverage; see project memory).
model ActiveOutletMonthly {
  id              String   @id @default(cuid())
  year            String
  month           String
  monthIndex      Int
  principal       String
  salesRole       String
  distinctOutlets Int
  transactions    Int
  sales           Float
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([year, month, principal, salesRole])
  @@index([year, month])
}

// Timestamps — one row per rep-outlet-day call from the "pine" field-force DB,
// current calendar month only (deliberately, matching the source script's own
// design). Full table replace every sync (scripts/db-bridge/active-outlets via
// app/api/timestamps/upload) — this table always holds "this month," never
// accumulates history, same precedent as PLEntry's full-aggregate-then-replace.
// Rep-daily summaries (First/Last Call, Strike Rate %, Outlets Covered) are
// aggregated live from this table on read, not stored separately.
model RepCall {
  id                String   @id @default(cuid())
  date              DateTime
  employeeCode      String
  salesRep          String
  employeeGroup     String
  salesRole         String
  region            String
  callSequence      Int
  callTime          DateTime
  callOutcome       String // "Sale" | "No Sale"
  noSaleReason      String?
  outletId          String
  outletName        String
  channel           String
  subChannel        String
  territory         String
  costCentresBought String // comma-joined, matches the source script's "Cost Centres Bought"
  intervalMins      Float? // minutes since this rep's previous call that day; null for the first
  documents         Int
  sales             Float
  qty               Float
  // Quantity expressed in cases (pieces ÷ source product UOM). Null means at
  // least one product line in this outlet visit had no usable UOM, so reporting
  // must show it as unavailable rather than understate the visit.
  cases             Float?
  firstCallOfDay    DateTime
  lastCallOfDay     DateTime
  hoursInDay        Float
  callsInDay        Int
  productiveInDay   Int
  createdAt         DateTime @default(now())

  @@unique([date, employeeCode, outletId])
  @@index([date])
  @@index([employeeCode, date])
}

// Upfield DataEdge SalesRawData — one row per invoice/item/document line,
// uploaded by F:\UpfieldSalesRawData every five minutes. Kept separate from
// RepCall and EablCall because this source is transaction-line activity rather
// than a Pine outlet visit or an EABL DMS check-in/check-out call. The stable
// sourceRecordId makes the scheduler's full-day replay genuinely idempotent.
model UpfieldTransaction {
  sourceRecordId    String   @id
  type              String // "sale" | "return"
  txnDate           DateTime
  invoiceNo         String
  docNo             String
  custCode          String?
  custName          String?
  itemCode          String
  itemDesc          String?
  itemPrice         Float?
  qty               Float?
  saleExcl          Float?
  disc              Float?
  vat               Float?
  saleIncl          Float?
  fsr               String?
  printedBy         String?
  sourceFile        String?
  lastSeenSyncRunId String
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  @@index([txnDate])
  @@index([fsr, txnDate])
  @@index([custCode, txnDate])
  @@index([lastSeenSyncRunId])
}

// One logical full-day scheduler cycle. A run is COMPLETE only after every
// batch from 1 through the final batch is present; only then is the shared
// SyncWatermark advanced for dashboard freshness reporting.
model UpfieldSyncRun {
  syncRunId        String    @id
  source           String
  windowStart      DateTime
  windowEnd        DateTime
  status           String    @default("IN_PROGRESS") // "IN_PROGRESS" | "COMPLETE"
  lastBatchNumber  Int       @default(0)
  finalBatchNumber Int?
  recordCount      Int       @default(0)
  completedAt      DateTime?
  updatedAt        DateTime  @updatedAt
  createdAt        DateTime  @default(now())

  batches UpfieldSyncBatch[]

  @@index([windowEnd])
  @@index([status, updatedAt])
}

// Batch receipt ledger prevents a network retry from being counted twice and
// rejects reuse of the same syncRunId/batchNumber with different content.
model UpfieldSyncBatch {
  id          String   @id @default(cuid())
  syncRunId   String
  batchNumber Int
  payloadHash String
  recordCount Int
  receivedAt  DateTime @default(now())

  run UpfieldSyncRun @relation(fields: [syncRunId], references: [syncRunId], onDelete: Cascade)

  @@unique([syncRunId, batchNumber])
  @@index([syncRunId])
}

// Upfield DataEdge Timestamp Report (Outlet Visit Detail) — one row per FSR
// outlet visit (check-in/check-out), uploaded by F:\UpfieldSalesRawData 4x/day
// (10:00/12:00/17:00/20:00 Africa/Nairobi). Kept separate from
// UpfieldTransaction because this source is visit/timestamp activity rather
// than sales transaction lines - shares UpfieldSyncRun/UpfieldSyncBatch via
// source="upfield-visits" and its own SyncWatermark bridge="upfield-visits".
//
// Schema-only reconciliation (2026-08-29): copied as-is from the unmerged
// origin/add-upfield-visits-route branch — see
// [[sales-dashboard-shared-prod-schema-risk]] project memory.
model UpfieldVisit {
  sourceRecordId    String    @id
  fsr               String
  distributor       String?
  pop               String
  startTime         DateTime
  endTime           DateTime?
  timeInOutlet      String?
  transitTime       String?
  lppc              Float?
  sale              Float?
  sourceFile        String?
  lastSeenSyncRunId String
  updatedAt         DateTime  @updatedAt
  createdAt         DateTime  @default(now())

  @@index([startTime])
  @@index([fsr, startTime])
  @@index([pop, startTime])
  @@index([lastSeenSyncRunId])
}

// EABL Call Performance — a separate call-level feed from the Pinefrost
// Analytics SQL Server source for EABL-Nyeri and EABL-Nyahururu. It must not
// be combined with RepCall: the two sources have different identities,
// timekeeping fields and sales definitions.
model EablCall {
  id                   String    @id @default(cuid())
  sourceCallKey        String    @unique
  callDate             DateTime
  salesman             String
  agent                String?
  // SAP MasterData.Customers.DMSCustomerCode — confirmed live as a 100%
  // reliable join key against DSR_Calls.CustomerCode (817/817 matched).
  // Nullable: historical rows synced before this field existed never had it
  // selected, and it's never used to gate anything — customerName remains
  // the call's own identity, this is purely an optional join key onto
  // EablCustomerMaster for whoever wants richer outlet detail.
  customerCode         String?
  customerName         String
  customerType         String?
  segment              String?
  timeIn               DateTime?
  timeOut              DateTime?
  durationMinutes      Int?
  firstCallOfDay       DateTime?
  lastCallOfDay        DateTime?
  callsInDay           Int
  productiveCallsInDay Int
  dayStrikeRatePct     Float?
  cashSales            Float
  creditSales          Float
  discounts            Float
  netSales             Float
  isProductive         Boolean
  createdAt            DateTime  @default(now())

  @@index([callDate])
  @@index([salesman, callDate])
  @@index([segment, callDate])
  @@index([customerCode])
}

// EABL customer master — SAP MasterData.Customers, scoped to only the
// customers with real DSR_Calls activity (~817 of the master's 1,010 rows;
// the rest belong to other areas entirely - "Mountain KSO", "Offtrade" -
// unrelated to EABL-Nyeri/Nyahururu). Feeds two things: a real join target
// for EablCall.customerCode, and — via
// /api/integrations/coaching/reference?resource=eabl-customers — Field
// Forms' coaching Master Data, the same way ActiveOutlet already feeds
// resource=outlets. No PJP-ownership-equivalent field: confirmed live that
// no "assigned rep" concept exists anywhere in the source master data
// (MasterData.OutletActivityAccess looked like a candidate but is empty and
// is visit-frequency tracking, not ownership) - not fabricated here.
model EablCustomerMaster {
  id         String   @id @default(cuid())
  customerId String   @unique // DMSCustomerCode
  // "EABL-Nyeri" / "EABL-Nyahururu" derived from the source Territory field,
  // matching EablCall's own scope naming. "EABL-General" is the honest
  // fallback for a real third territory (Othaya) with no named principal to
  // map onto - never silently dropped or guessed onto the nearest one.
  principal  String
  outletName String
  channel    String?
  subChannel String?
  territory  String?
  // Source SAP `Route` field (e.g. "EABL-Kiganjo") - finer-grained than
  // territory, prefixed to avoid colliding with a same-named Pine route
  // once synced into Field Forms' coaching_routes. Null when the source
  // route is genuinely unset ("NA - Unknown").
  route      String?
  latitude   Float?
  longitude  Float?
  status     String // "ACTIVE" | "INACTIVE" (source CustomerStatus)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@index([principal])
  @@index([status])
}

// Order 360 — one row per SAP order, sourced directly from pine's SAP_Orders
// (joined to users/loading/vans/payments), mirroring
// Order_360_Extractor.py's QUERY. Funnel/pending/age/leaderboard figures are all
// derived live from these boolean flags + orderDate on read
// (lib/order360Summary.ts) — nothing here is precomputed. Initial load covers
// the trailing 3 months; a daily 18:30 sync then tops up only that day's rows
// (scripts/db-bridge/order-360/run.ts), same incremental philosophy as RepCall.
model OrderRecord {
  id            String   @id @default(cuid())
  orderDate     DateTime // so.Creation_Date, date-truncated
  erpNumber     String // so.DocNum - natural key
  invoiceNumber String? // so.Reference_No
  picklistId    String?
  customer      String
  fsr           String
  amount        Float

  clearedBy   String?
  cleared     Boolean
  clearedDate DateTime?

  picker   String?
  picked   Boolean
  pickDate DateTime?

  dispatcher   String?
  dispatched   Boolean
  dispatchDate DateTime?

  auditedBy String?
  audited   Boolean

  van          String?
  driver       String?
  // Curated "Name - REG" attribution from the source query's hardcoded van/driver
  // directory (keyed off the driver's Pine username) - the authoritative display
  // name for delivery attribution once present; van/driver above stay as the raw
  // Pine values. Null when the driver isn't in that directory.
  deliveredBy  String?
  delivered    Boolean
  deliveryDate DateTime?

  isReturn      Boolean
  returnDocType String? // raw so.Doc_Type ("Credit Note") when isReturn
  returnedBy    String?

  podStatus  String?
  // Confirmed payment methods, joined from Pine payments (for example
  // open_terms, cash, mpesa_on_delivery, cheque, mpesa_stk_checkout).
  paymentModes String?
  stk        Boolean
  // Explicit STK Push state; never inferred from a POD/reference alone.
  stkPushStatus String?
  stkPaymentRef String?
  stkAmountPaid Float?
  paymentRef String?
  amountPaid Float?

  createdAt DateTime @default(now())

  @@unique([erpNumber])
  @@index([orderDate])
  @@index([fsr])
}

// Journey Plan — one row per planned rep x outlet x date, derived from the
// "pine" field-force DB's historical visit-frequency + geo-sweep route/home-day
// algorithm (scripts/db-bridge/jp-adherence), pushed live via
// app/api/jp-adherence/upload/plan. Route/frequency is COMPUTED from a
// trailing 90-day lookback every sync (LOOKBACK_DAYS in run.ts) so it reflects
// a rep's current territory, but only the most recent RECENT_UPLOAD_DAYS (7)
// worth of rows are actually persisted here — the first live run generated
// 800K+ rows across the full 90 days (862 reps x ~65 workdays), which is both
// The Journey Plan is now an authoritative business upload (scripts/jp-adherence/
// import-plan.ts, from a Journey Plan workbook), not a derived/inferred route —
// one row per planned rep/outlet/date visit, matching the source file's own grain.
// Adherence itself (planned vs actual) is computed live by joining this table
// against RepCall (Timestamps' own live-synced data) in lib/jpAdherence.ts, rather
// than stored in a separately-synced table — there is nothing here to keep in sync
// on a schedule, only whatever the latest uploaded plan says. principal is
// deliberately not stored here: JP Adherence's principal scoping has always been
// EmployeePrincipalContribution-based (a rep can be relevant to several JPA
// principals), resolved via join at query time, same as before. teamLeader is
// display-only, sourced straight from the upload — never used for access scoping
// (that's TeamLeaderScope/employeeCode, as everywhere else in this app).
model JourneyPlanRow {
  id           String   @id @default(cuid())
  date         DateTime
  day          String // "Monday".."Sunday", from source
  employeeCode String
  employeeName String
  customerId   String
  customerName String
  region       String // source "Location"
  teamLeader   String // display only — never used for access scoping
  routeName    String
  subRegion    String
  salesRole    String // "Primary Sales" | "Secondary Sales"
  channel      String
  monthLabel   String // "Jul-2026" — convenience for the Month filter/display
  createdAt    DateTime @default(now())

  @@unique([date, employeeCode, customerId])
  @@index([date])
  @@index([employeeCode, date])
}

// Weekly revenue targets per Team Leader x Principal x Week, entered via
// /weekly-targets (replicates WeeklyTargetEntry_MacroSystem.xlsm). Grid rows are
// lazily generated (up to "today + 8 weeks") only for (teamLeaderId, principal)
// pairs present in TeamLeaderAssignment — not a blind cross-product of every team
// leader x every principal like the source workbook, so Filled/Pending % stays
// meaningful. Week convention matches the source file: 5 calendar-weeks-of-month,
// Monday-start, "Apr Week 1"-style labels kept alongside weekStartDate (the real,
// unambiguous key). Historical weeks stay editable indefinitely — no locking.
model WeeklyTarget {
  id             String   @id @default(cuid())
  teamLeaderId   String
  principal      String
  year           String
  monthLabel     String
  weekLabel      String
  weekStartDate  DateTime
  targetValue    Float    @default(0)
  lastModifiedBy String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([teamLeaderId, principal, weekStartDate])
  @@index([teamLeaderId, weekStartDate])
  @@index([weekStartDate])
}

// One row per edit made through the Weekly Targets grid, same shape/rationale as
// TargetAuditLog.
model WeeklyTargetAuditLog {
  id            String   @id @default(cuid())
  timestamp     DateTime @default(now())
  userEmail     String
  action        String // "CREATE" | "UPDATE" | "DELETE"
  teamLeaderId  String
  principal     String
  weekStartDate DateTime
  changes       Json

  @@index([teamLeaderId, weekStartDate])
}

// Contribution-by-Rep — each rep's share of a principal's trailing revenue among
// reps assigned to that principal (TeamLeaderAssignment), computed from
// JPMonthlySplitRow as the final step of scripts/db-bridge/jp-adherence/run.ts.
// Full table replace every computation (not upsert-on-key), same rationale as
// JPMonthlySplitRow itself — reflects only the current trailing window. Drives
// the read-time rep-level split of Monthly/Weekly targets (repTarget =
// principalTarget x sharePct) and the weekday-weighted DailyTarget below.
model RepContribution {
  id             String   @id @default(cuid())
  principal      String
  employeeCode   String
  employeeName   String
  teamLeaderId   String?
  quarterRevenue Float
  sharePct       Float
  computedAt     DateTime @default(now())

  @@unique([principal, employeeCode])
  @@index([principal])
}

// Daily Projection — each rep's WeeklyTarget split across weekdays by their own
// productive-visit-count histogram from the preceding calendar week
// (JPAdherenceDetail.productiveFlag), falling back to their trailing-90-day
// histogram, then an even weekday split, if that history is too sparse (same
// layered-fallback shape as JP Adherence's home-day derivation). Persisted
// (unlike the read-time-only rep-level Monthly/Weekly split) because reps need a
// fast "today's number" read and the weekday-weight computation is worth doing
// once rather than per page view. Full-replace per (employeeCode, principal,
// week) whenever the parent WeeklyTarget is saved, and again on each JP
// Adherence sync to roll the preceding-week pattern forward.
model DailyTarget {
  id                String   @id @default(cuid())
  employeeCode      String
  employeeName      String
  principal         String
  teamLeaderId      String
  date              DateTime
  targetValue       Float
  weeklyTargetId    String
  sharePctUsed      Float
  weekdayWeightUsed Float
  createdAt         DateTime @default(now())

  // teamLeaderId is part of the key, not just employeeCode/principal/date — a
  // rep can genuinely be an active assignment under more than one Team Leader
  // for the same principal (e.g. Mars-Nairobi's 5 Team Leaders can share
  // reps), so recomputeDailyTargets (lib/repContribution.ts) can legitimately
  // produce one row per Team Leader for the same rep/principal/day. Confirmed
  // by a real production collision on (employeeCode, principal, date) alone
  // once the updated Roster introduced multiple Team Leaders per principal.
  @@unique([employeeCode, principal, teamLeaderId, date])
  @@index([date])
  @@index([employeeCode, date])
}

// Daily AI-generated executive digest — one row per generation run, produced by
// /api/ai-insights/generate (Claude Sonnet 5) from current Sales-vs-Target and
// Sync Health data, then displayed on /dashboard so it doesn't need
// regenerating on every page view. findings is JSON-serialized
// AiInsightFinding[] (see lib/aiInsights.ts) rather than a relational table —
// a small, display-only structure with no need for independent querying.
model AiInsight {
  id            String   @id @default(cuid())
  generatedAt   DateTime @default(now())
  summary       String
  findings      String // JSON-serialized AiInsightFinding[]
  model         String // the Claude model ID that produced this digest
  periodKind    String   @default("MTD") // PeriodKind from lib/timeIntelligence.ts, matching the top PeriodSelector's selection at generation time
  periodYear    String   @default("")
  periodMonth   String?
  periodToYear  String? // CUSTOM range only
  periodToMonth String? // CUSTOM range only
  principalKey  String? // exact raw Principal string from the Sales dataset, or null for "All Principals"
  cacheKey      String   @default("") // periodKind|year|month|toYear|toMonth|principalKey — exact-match lookup for "is there already a fresh digest for this selection"

  @@index([generatedAt])
  @@index([cacheKey, generatedAt])
}

// Frost conversation history (Phase 3 of the Frost AI agent expansion) — lets
// a user's chat survive a page refresh and gives a plain audit trail, without
// building a heavier memory system than the app actually needs. One
// FrostConversation per chat session; FrostConversationMessage holds the
// individual turns. userId is a plain string (no @relation, matching every
// other cross-model reference in this schema) rather than a Prisma relation —
// ownership is checked in app code (app/api/frost/chat/route.ts) before a
// conversationId from the client is trusted.
model FrostConversation {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model FrostConversationMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // "user" | "assistant"
  content        String
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
}

// Sales & Returns invoice-line detail, sourced from the field DMS (CASHMEMO/
// CASHMEMO_DETAIL/DSR/POP/SKU tables — a separate SQL Server source from SAP
// and PinefrostAnalytics), via scripts/db-bridge/sales-returns. One row per
// Invoice x Material line; CASHMEMO_TYPE 01/06 are invoices, 18/19 are credit
// notes for returns — both land here so returns can be netted against sales
// by document type. deliveryDate (CM.DELV_DATE) is the field the source query
// filters on and is what /api/sales-returns/upload uses for its window
// delete-and-replace; invoiceDate (CM.DOC_DATE, the posting date shown on the
// report) can differ from it.
model SalesReturnLine {
  id                String    @id @default(cuid())
  // `${invoiceNo}|${sku}` — unique per the source query's grain (GROUP BY is
  // per invoice + material, never split further by batch).
  sourceRowKey      String    @unique
  customerCode      String
  salesRepCode      String
  salesRepName      String
  route             String?
  routeName         String
  invoiceNo         String
  invoiceDate       DateTime?
  deliveryDate      DateTime
  documentType      String
  documentTypeDesc  String
  referenceDocument String?
  referenceDocDate  DateTime?
  hdmsOrderNo       String?
  sku               String
  skuDesc           String
  storageLocation   String
  piecesPerCase     Int?
  listPricePerCase  Float?
  saleQtyPieces     Float
  freeQtyPieces     Float
  grossSale         Float
  netSale           Float
  bonusDiscount     Float
  tradeDiscount     Float
  cashDiscount      Float
  totalDiscount     Float
  createdAt         DateTime  @default(now())

  @@index([deliveryDate])
  @@index([salesRepCode, deliveryDate])
  @@index([customerCode])
  @@index([documentType])
}

// PJP (route) x SKU month-to-date performance — a second report fed by the
// same Centegy SQL Server bridge as SalesReturnLine (scripts/db-bridge/sales-returns/run.ts),
// reusing its connection rather than a separate scheduled task. Unlike
// SalesReturnLine's per-day delivery-date window, the source query always
// recomputes the whole current month, so each run fully replaces that
// month's rows (see app/api/pjp-sku-performance/upload) rather than
// appending — a row here is a snapshot, not an immutable fact.
model PjpSkuPerformance {
  id        String   @id @default(cuid())
  month     DateTime // first-of-month marker (Africa/Nairobi) this snapshot covers
  pjp       String // route/journey-plan code
  route     String // route description
  skuCode   String
  skuDesc   String
  ecoMtd    Int // distinct outlets (town+locality+slocality+pop) visited so far this month
  skuSales  Float
  pcs       Float
  updatedAt DateTime @updatedAt

  @@unique([month, pjp, skuCode])
  @@index([month])
}

// Outlet x SKU net sales (sales netted against returns), per delivery day —
// a third report fed by the same Centegy SQL Server bridge as
// SalesReturnLine and PjpSkuPerformance (scripts/db-bridge/sales-returns/run.ts).
// Per-day fact grain like SalesReturnLine (not a month-wide recompute like
// PjpSkuPerformance) — delete-and-replace by date window on each run, see
// app/api/outlet-sku-daily-sales/upload.
model OutletSkuDailySales {
  id              String   @id @default(cuid())
  // `${distributor}|${pjp}|${dsrName}|${outletCode}|${sku}|${date}` — unique
  // per the source query's grain.
  sourceRowKey    String   @unique
  distributor     String
  distributorName String
  pjp             String
  dsrName         String
  outletCode      String
  outletName      String
  date            DateTime
  channel         String
  category        String
  brand           String
  sku             String
  skuDesc         String
  pcs             Float
  amount          Float
  discount        Float
  discountPercent Float?
  netSales        Float
  createdAt       DateTime @default(now())

  @@index([date])
  @@index([outletCode, date])
  @@index([sku])
  @@index([pjp])
}

// PJP/DSR daily activity — a fourth report fed by the same Centegy SQL
// Server bridge (scripts/db-bridge/sales-returns/run.ts), built from
// CASHMEMO.DATE_ENTRY: the handheld device's actual capture timestamp,
// confirmed (by sampling live data) to carry real time-of-day variation,
// unlike DELV_DATE/DOC_DATE which always sit at exactly 00:00:00. Per-day
// fact grain like OutletSkuDailySales — delete-and-replace by date window,
// see app/api/pjp-dsr-daily-activity/upload.
model PjpDsrDailyActivity {
  id           String   @id @default(cuid())
  // `${pjp}|${dsr}|${date}` — unique per the source query's grain.
  sourceRowKey String   @unique
  date         DateTime
  pjp          String
  route        String
  dsr          String
  dsrName      String
  transactionCount          Int
  outletsVisited            Int
  // How many of transactionCount actually came from a handheld device
  // (HHT_SRNO not null/'0') rather than manual/office entry — some PJPs
  // consistently show 0 here, meaning their timestamps below don't reflect
  // real field activity. Check this before trusting a given row's timing.
  handheldTransactionCount  Int
  firstEntryTime            DateTime?
  lastEntryTime             DateTime?
  activeSpanMinutes         Int?
  avgGapMinutes             Float?
  createdAt                 DateTime @default(now())

  @@index([date])
  @@index([pjp, date])
  @@index([dsr, date])
}
