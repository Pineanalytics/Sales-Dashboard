// Prisma schema for the Sales Performance Dashboard.
// Postgres (Supabase), connected via the pooled connection for app queries
// and the direct connection for migrations/db push (see .env.example).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Snapshot {
  id          String   @id @default(cuid())
  uploadedAt  DateTime @default(now())
  reportTitle String
  data        String // JSON-serialized Dataset (see lib/types.ts)

  @@index([uploadedAt])
}

enum Role {
  ADMIN
  VIEWER
  TEAM_LEADER
}

enum UserStatus {
  PENDING
  APPROVED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String?
  passwordHash String
  role         Role       @default(VIEWER)
  status       UserStatus @default(APPROVED) // admin-created users are pre-approved; self-registered rows start PENDING
  allowedPages String[]   @default([]) // report page keys this user can see; ignored for ADMIN (always full access)
  teamLeaderId String?    @unique // links a TEAM_LEADER-role login to their TeamLeader row; unused for ADMIN/VIEWER
  // Restricts a VIEWER-role login to specific principals (Cost Centres) across the whole
  // app — dataset, every Prisma-backed dashboard/report route, and Frost — the same
  // scoping mechanism a TEAM_LEADER already gets via teamLeaderId, just principal-only
  // (no rep/employeeCode identity of their own). Empty = unrestricted, matching this
  // project's "default-all-pages on approval" convention: an existing VIEWER's access
  // never narrows just because this field shipped. Unused for ADMIN/TEAM_LEADER.
  allowedPrincipals String[] @default([])
  createdAt    DateTime   @default(now())
}

// Admin-editable content for automated emails (currently just the new-modules
// announcement — see lib/email.ts's ANNOUNCEMENT_TEMPLATE_KEY). One row per
// email "key". Absence of a row (first run, or after "Reset to original")
// means the caller falls back to that email's DEFAULT_*_SUBJECT/BODY
// constants in lib/email.ts rather than erroring.
model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  subject   String
  body      String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

// Admin-maintained monthly targets, uploaded via a small dedicated form
// (app/(protected)/admin/targets) independent of the big Sales/Stock/Coverage
// refresh cycle. Overlaid onto Dataset.monthlySales[].target at read time by
// lib/datasetStore.ts, not baked into the Snapshot JSON blob at upload time.
model Target {
  id                 String   @id @default(cuid())
  year               String
  month              String
  monthIndex         Int
  principal          String
  mainPrincipal      String?
  valueTarget        Float?
  volumeTarget       Float?
  coverageTarget     Float?
  productivityTarget Float?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@unique([year, month, principal])
  @@index([year, month])
}

// One row per edit made through the Monthly Targets entry form (app/(protected)/
// admin/targets), mirroring the source Target_Per_Principal_System.xlsm workbook's
// AuditTrail sheet. `changes` holds { field: { old, new } } for whichever of the
// 4 target fields moved in that save — not written by the bulk-upload path, only
// the row-level Add/Edit/Delete form.
model TargetAuditLog {
  id        String   @id @default(cuid())
  timestamp DateTime @default(now())
  userEmail String
  action    String // "CREATE" | "UPDATE" | "DELETE"
  year      String
  month     String
  principal String
  changes   Json

  @@index([year, month, principal])
}

// Team Leader roster — one row per team leader, optionally linked to a login
// (User.teamLeaderId) once they have one. Admin-editable via /admin/team-leaders.
model TeamLeader {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// The "fact table" driving Weekly Targets: which reps, selling which principals,
// report up through which team leader. Admin-editable via /admin/team-leaders.
// A rep can appear under multiple principals, and (matrix orgs) under different
// team leaders per principal. This table is the source of truth for which
// (teamLeaderId, principal) pairs get a Weekly Target grid, and which reps are
// eligible for that principal's RepContribution split.
model TeamLeaderAssignment {
  id              String   @id @default(cuid())
  teamLeaderId    String
  employeeCode    String
  employeeName    String
  principal       String
  // Below: ported from Target_Management_System.xlsm's Roster sheet.
  channel         String? // free text, e.g. "KA" — matches the workbook's free-text Channel column
  // The Roster's "SAP Name" column — the rep's name as it appears in SAP, distinct from
  // employeeName (the "Employee (Sales Edge Name)" column, the Pine-side name). This is the
  // actual join key for matching rep-level revenue from the Excel-sourced Brand&Customer sheet
  // (MonthlyBrandCustomerRow.salesEmployee is a SAP-side name string) back to a Team Leader —
  // the Pine/SAP name-mismatch problem this project has hit before. Read from the source
  // workbook on the original Roster import but not persisted until now.
  sapName         String?
  // Admin-declared allocation %, distinct from RepContribution.sharePct (which is computed from
  // actual trailing revenue). Null = not yet declared for this rep/principal — falls back to the
  // computed share. When set, must sum to ~100% across active reps per principal (validated in
  // the admin UI, not enforced at the DB level).
  contributionPct Float?
  // Soft-remove flag — the normal way to take a rep off a principal (preserves WeeklyTarget/
  // DailyTarget/RepContribution history and this row's own audit trail). Hard delete still
  // exists for genuine mistakes.
  active          Boolean  @default(true)
  salesRole       String   @default("PRIMARY") // "PRIMARY" | "SECONDARY" — everyone PRIMARY for now
  // Below: ported from the updated Target_Management_System.xlsm's Roster sheet
  // (2026-08-03 refresh — 21 columns, up from the original 12-column import).
  // region/subRegion are Team-Leader-editable (their own reps only, see
  // targets-overview/actions.ts); the rest are reference data re-synced only by
  // re-running scripts/target-management/import.ts, not inline-editable — keeps
  // the Roster from drifting from the authoritative HR/ops source between imports.
  region                String?
  subRegion             String?
  supervisor            String?
  workGroup             String?
  company               String?
  costCenter            String?
  absolutePrincipal     String?
  costCenterCount       Int?
  salesPoint            String?
  route                 String?
  location              String?
  sourceContributionPct Float? // the Roster's own un-normalized "Source Contribution %" basis
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([teamLeaderId, employeeCode, principal])
  @@index([teamLeaderId])
  @@index([principal])
  @@index([region])
}

model TeamLeaderAssignmentAuditLog {
  id           String   @id @default(cuid())
  timestamp    DateTime @default(now())
  userEmail    String
  action       String // "CREATE" | "UPDATE" | "DEACTIVATE" | "REACTIVATE" | "DELETE"
  teamLeaderId String
  principal    String
  employeeCode String
  changes      Json

  @@index([teamLeaderId, principal])
}

// Admin-editable reference data (rarely changes), consumed by scripts/db-bridge
// as the item->principal/pack-size join for the SQL bridge, replacing the
// earlier network-share Excel read.
model Product {
  id             String   @id @default(cuid())
  itemNo         String   @unique
  packSize       Float?
  principal      String
  costPrice      Float?
  classification String?
  ssuConversion  Float?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

// Admin-editable reference data (rarely changes), consumed by scripts/db-bridge
// as the warehouse->location join for the SQL bridge.
model Warehouse {
  id            String   @id @default(cuid())
  warehouseCode String   @unique
  warehouseName String
  location      String
  locationCode  String
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

// Admin-editable reference data (rarely changes). Not currently consumed by
// scripts/db-bridge's transforms or any dashboard view — kept for completeness
// alongside Product/Warehouse.
model KeyAccountRep {
  id         String   @id @default(cuid())
  rep        String   @unique
  channel    String
  teamLeader String
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
}

// Monthly Sales (Revenue/COGS/Gross Profit) sourced directly from SAP SQL Server
// (scripts/db-bridge, YTD_Raw), pushed live via app/api/sales/upload. Unlike
// Target/PLEntry, this fully REPLACES Dataset.monthlySales at read time rather
// than merging a single field — once rows exist here, the Excel-sourced Sales
// figures in the Snapshot blob are no longer used (Target still overlays on top,
// same as before). Coverage/Brand&Customer/Stock/Weekly Projection remain
// Excel-sourced; this table intentionally covers Sales only.
model SalesRecord {
  id          String   @id @default(cuid())
  year        String
  month       String
  monthIndex  Int
  location    String
  principal   String
  revenue     Float
  cogs        Float
  grossProfit Float
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([year, month, principal])
  @@index([year, month])
}

// Day-grain sibling of SalesRecord — same SAP source (scripts/db-bridge/queries/
// dailySalesRaw.ts, a parallel query to ytdRaw.ts that doesn't collapse the real
// per-transaction TaxDate), same Product/Warehouse/Principal join
// (buildDailySales.ts), but kept as its own table rather than adding a `date`
// column to SalesRecord — SalesRecord's grain and unique key are month-level and
// already relied upon elsewhere; this exists specifically to give the Executive
// Overview's Week 1-4 / Daily Projection cards real actuals to compare against,
// not to replace the monthly pipeline. Only ever holds a bounded trailing window
// (see sales-sync.ts), not the whole year.
model DailySalesActual {
  id          String   @id @default(cuid())
  date        DateTime
  location    String
  principal   String
  revenue     Float
  cogs        Float
  grossProfit Float
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([date, principal, location])
  @@index([date])
  @@index([principal])
}

// Canonical employee master imported from the Employee Roaster workbook. Pine's
// Sales Rep Name and SAP's Sales Rep Name are intentionally both retained: Pine
// drives operational activity (coverage, productivity, JPA, timestamps), while
// SAP is the source of truth for transaction value and volume. `absolutePrincipal`
// is deliberately sourced only from the Employee Roaster sheet.
model EmployeeMaster {
  id                String   @id @default(cuid())
  employeeCode      String   @unique
  company           String?
  pineName          String
  sapName           String
  absolutePrincipal String
  salesRole         String
  workGroup         String?
  region            String?
  subRegion         String?
  teamLeader        String?
  supervisor        String?
  active            Boolean  @default(true)
  costCenterCount   Int?
  salesPoint        String?
  route             String?
  location          String?
  importedAt        DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdAt         DateTime @default(now())

  contributions EmployeePrincipalContribution[]

  @@index([absolutePrincipal])
  @@index([active])
  @@index([sapName])
}

// A rep may be operationally rostered to one absolute principal yet contribute
// to more than one principal. This sheet is the source of truth for JPA/target
// eligibility; it is intentionally separate from EmployeeMaster.absolutePrincipal
// so Timestamp reporting cannot be reassigned by a contribution allocation.
model EmployeePrincipalContribution {
  id              String   @id @default(cuid())
  employeeId      String
  principal       String
  salesRole       String
  contributionPct Float
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  employee EmployeeMaster @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, principal])
  @@index([principal])
  @@index([employeeId])
}

// Rep-grain SAP actuals. These are generated only from SAP invoice/credit-note
// transactions and carry both the SAP salesperson name and the resolved Pine
// employee identity. Rows without a master match are retained with a null
// employeeCode so unmatched SAP revenue is never silently discarded.
model SalesRepActual {
  id           String   @id @default(cuid())
  year         String
  month        String
  monthIndex   Int
  location     String
  principal    String
  sapName      String
  employeeCode String?
  employeeName String?
  volume       Float
  revenue      Float
  cogs         Float
  grossProfit  Float
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([year, month, principal, sapName])
  @@index([principal, year, month])
  @@index([employeeCode, year, month])
}

// Day-grain companion to SalesRepActual. It supports operational drill-downs
// without changing the existing DailySalesActual principal-level feed.
model DailySalesRepActual {
  id           String   @id @default(cuid())
  date         DateTime
  location     String
  principal    String
  sapName      String
  employeeCode String?
  employeeName String?
  volume       Float
  revenue      Float
  cogs         Float
  grossProfit  Float
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([date, principal, sapName])
  @@index([date, principal])
  @@index([employeeCode, date])
}

// P&L journal-entry lines from SAP (OJDT/JDT1 by Cost Centre/Account), pushed
// live by scripts/pl-bridge (not shadow-only, unlike scripts/db-bridge) via
// app/api/pl/upload. Aggregated to Year+Month+Principal+AccountCode+LineType
// grain before storage — never one row per raw JE line. Overlaid onto
// Dataset.monthlyPL at read time by lib/datasetStore.ts, same pattern as Target.
model PLEntry {
  id          String   @id @default(cuid())
  year        String
  month       String
  monthIndex  Int
  principal   String // Cost Centre — same raw Principal-Location string as MonthlySalesRow.principal
  accountCode String
  accountName String
  lineType    String // "REVENUE" | "COGS" | "EXPENSE" | "OTHER_INCOME"
  amount      Float
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([year, month, principal, accountCode, lineType])
  @@index([year, month])
}

// Active Outlets — outlet-level YTD purchase-event summary from the "pine"
// field-force DB, one row per Year+Principal+CustomerID, pushed live by
// scripts/db-bridge/active-outlets via app/api/active-outlets/upload. Read
// directly by app/(protected)/(analytics)/active-outlets/page.tsx — not part
// of Dataset/Snapshot, since this has no Excel-sourced equivalent. Powers
// outlet drill-down plus Channel/Sub Channel/Frequency-Band breakdowns,
// aggregated live from this table rather than pre-baked.
//
// timesBought/purchaseDays/activeMonths/sales/qty/firstPurchaseDate/
// lastPurchaseDate are DERIVED (a SQL aggregate over ActiveOutletEvent, see
// below) — not accumulated in-memory from a full YTD re-fetch every sync.
// status is set during the nightly full-recompute pass only (see
// SyncWatermark) — an outlet whose lastPurchaseDate has gone stale (60+
// days) flips to "Inactive"; incremental runs never touch this field.
model ActiveOutlet {
  id                 String   @id @default(cuid())
  year               String
  principal          String // Cost Centre, matches other principal fields' raw string
  customerId         String // pine.outlets o_id
  outletName         String
  channel            String
  subChannel         String
  territory          String
  salesRole          String // dominant role for the period: "Primary Sales" | "Secondary Sales"
  status             String   @default("Active") // "Active" | "Inactive"
  timesBought        Int
  purchaseDays       Int
  activeMonths       Int
  firstPurchaseDate  DateTime
  lastPurchaseDate   DateTime
  frequencyBand      String // e.g. "One-time Buyer", "Regular - About Monthly"
  sales              Float
  qty                Float
  mostRecentRep      String?
  mostRecentRepGroup String?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  @@unique([year, principal, customerId])
  @@index([year, principal])
}

// Append-only event ledger backing ActiveOutlet — one row per source
// sale/order document. This is the "parent data" incremental syncs append
// to (see scripts/db-bridge/active-outlets/run.ts); ActiveOutlet's summary
// fields are a SQL aggregate over this table, not an in-memory accumulation
// replayed from a full YTD MySQL re-fetch every run. Insert is always
// ON CONFLICT DO NOTHING on the unique key below — genuinely idempotent, so
// an incremental sync's deliberate fetch-window overlap (guards against
// Pine write-latency/clock skew) can never double-count an event.
//
// outletName/channel/subChannel/territory/salesRole/repName/repGroup are
// denormalized onto every event row (redundant across an outlet's many
// events, cheap at this scale) rather than looked up at derivation time —
// the upload route has no access to Pine's MySQL, only what the sync script
// already resolved and sent, so the ledger needs to be self-contained for
// the derivation query below to produce a complete ActiveOutlet row.
model ActiveOutletEvent {
  id         String   @id @default(cuid())
  year       String
  principal  String
  customerId String
  docId      String // pine.sales/orders doc id
  isOrder    Boolean
  date       DateTime
  sales      Float
  qty        Float
  salesRole  String // "Primary Sales" | "Secondary Sales" — this event's own role
  outletName String
  channel    String
  subChannel String
  territory  String
  repName    String?
  repGroup   String?
  createdAt  DateTime @default(now())

  @@unique([year, principal, customerId, docId, isOrder])
  @@index([year, principal, customerId])
  @@index([date])
}

// Tracks per-bridge sync progress so scripts/db-bridge/*/run.ts can decide
// full-vs-incremental mode instead of every scheduled run re-fetching a full
// source window. lastIncrementalAt is the newest source event timestamp
// incorporated so far (the fetch-since boundary, minus each bridge's own
// overlap buffer); lastFullResyncAt is when the last full/safety-net
// recompute completed — a run is forced into full mode once this is missing
// or older than ~22h, self-scheduling roughly one full pass a day without
// any time-of-day logic. One row per bridge ("active-outlets", "jp-adherence", ...).
model SyncWatermark {
  id                String    @id @default(cuid())
  bridge            String    @unique
  lastIncrementalAt DateTime
  lastFullResyncAt  DateTime?
  updatedAt         DateTime  @updatedAt
}

// Monthly trend for Active Outlets: distinct outlets per Cost Centre, split
// Primary/Secondary, RE-COUNTED per month — never derived by summing
// ActiveOutlet rows across months (same "unique not repeated sums" rule
// already established for Coverage; see project memory).
model ActiveOutletMonthly {
  id              String   @id @default(cuid())
  year            String
  month           String
  monthIndex      Int
  principal       String
  salesRole       String
  distinctOutlets Int
  transactions    Int
  sales           Float
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())

  @@unique([year, month, principal, salesRole])
  @@index([year, month])
}

// Timestamps — one row per rep-outlet-day call from the "pine" field-force DB,
// current calendar month only (deliberately, matching the source script's own
// design). Full table replace every sync (scripts/db-bridge/active-outlets via
// app/api/timestamps/upload) — this table always holds "this month," never
// accumulates history, same precedent as PLEntry's full-aggregate-then-replace.
// Rep-daily summaries (First/Last Call, Strike Rate %, Outlets Covered) are
// aggregated live from this table on read, not stored separately.
model RepCall {
  id                String   @id @default(cuid())
  date              DateTime
  employeeCode      String
  salesRep          String
  employeeGroup     String
  salesRole         String
  region            String
  callSequence      Int
  callTime          DateTime
  callOutcome       String // "Sale" | "No Sale"
  noSaleReason      String?
  outletId          String
  outletName        String
  channel           String
  subChannel        String
  territory         String
  costCentresBought String // comma-joined, matches the source script's "Cost Centres Bought"
  intervalMins      Float? // minutes since this rep's previous call that day; null for the first
  documents         Int
  sales             Float
  qty               Float
  firstCallOfDay    DateTime
  lastCallOfDay     DateTime
  hoursInDay        Float
  callsInDay        Int
  productiveInDay   Int
  createdAt         DateTime @default(now())

  @@unique([date, employeeCode, outletId])
  @@index([date])
  @@index([employeeCode, date])
}

// Journey Plan — one row per planned rep x outlet x date, derived from the
// "pine" field-force DB's historical visit-frequency + geo-sweep route/home-day
// algorithm (scripts/db-bridge/jp-adherence), pushed live via
// app/api/jp-adherence/upload/plan. Route/frequency is COMPUTED from a
// trailing 90-day lookback every sync (LOOKBACK_DAYS in run.ts) so it reflects
// a rep's current territory, but only the most recent RECENT_UPLOAD_DAYS (7)
// worth of rows are actually persisted here — the first live run generated
// 800K+ rows across the full 90 days (862 reps x ~65 workdays), which is both
// The Journey Plan is now an authoritative business upload (scripts/jp-adherence/
// import-plan.ts, from a Journey Plan workbook), not a derived/inferred route —
// one row per planned rep/outlet/date visit, matching the source file's own grain.
// Adherence itself (planned vs actual) is computed live by joining this table
// against RepCall (Timestamps' own live-synced data) in lib/jpAdherence.ts, rather
// than stored in a separately-synced table — there is nothing here to keep in sync
// on a schedule, only whatever the latest uploaded plan says. principal is
// deliberately not stored here: JP Adherence's principal scoping has always been
// EmployeePrincipalContribution-based (a rep can be relevant to several JPA
// principals), resolved via join at query time, same as before. teamLeader is
// display-only, sourced straight from the upload — never used for access scoping
// (that's TeamLeaderScope/employeeCode, as everywhere else in this app).
model JourneyPlanRow {
  id           String   @id @default(cuid())
  date         DateTime
  day          String // "Monday".."Sunday", from source
  employeeCode String
  employeeName String
  customerId   String
  customerName String
  region       String // source "Location"
  teamLeader   String // display only — never used for access scoping
  routeName    String
  subRegion    String
  salesRole    String // "Primary Sales" | "Secondary Sales"
  channel      String
  monthLabel   String // "Jul-2026" — convenience for the Month filter/display
  createdAt    DateTime @default(now())

  @@unique([date, employeeCode, customerId])
  @@index([date])
  @@index([employeeCode, date])
}

// Weekly revenue targets per Team Leader x Principal x Week, entered via
// /weekly-targets (replicates WeeklyTargetEntry_MacroSystem.xlsm). Grid rows are
// lazily generated (up to "today + 8 weeks") only for (teamLeaderId, principal)
// pairs present in TeamLeaderAssignment — not a blind cross-product of every team
// leader x every principal like the source workbook, so Filled/Pending % stays
// meaningful. Week convention matches the source file: 5 calendar-weeks-of-month,
// Monday-start, "Apr Week 1"-style labels kept alongside weekStartDate (the real,
// unambiguous key). Historical weeks stay editable indefinitely — no locking.
model WeeklyTarget {
  id             String   @id @default(cuid())
  teamLeaderId   String
  principal      String
  year           String
  monthLabel     String
  weekLabel      String
  weekStartDate  DateTime
  targetValue    Float    @default(0)
  lastModifiedBy String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  @@unique([teamLeaderId, principal, weekStartDate])
  @@index([teamLeaderId, weekStartDate])
  @@index([weekStartDate])
}

// One row per edit made through the Weekly Targets grid, same shape/rationale as
// TargetAuditLog.
model WeeklyTargetAuditLog {
  id            String   @id @default(cuid())
  timestamp     DateTime @default(now())
  userEmail     String
  action        String // "CREATE" | "UPDATE" | "DELETE"
  teamLeaderId  String
  principal     String
  weekStartDate DateTime
  changes       Json

  @@index([teamLeaderId, weekStartDate])
}

// Contribution-by-Rep — each rep's share of a principal's trailing revenue among
// reps assigned to that principal (TeamLeaderAssignment), computed from
// JPMonthlySplitRow as the final step of scripts/db-bridge/jp-adherence/run.ts.
// Full table replace every computation (not upsert-on-key), same rationale as
// JPMonthlySplitRow itself — reflects only the current trailing window. Drives
// the read-time rep-level split of Monthly/Weekly targets (repTarget =
// principalTarget x sharePct) and the weekday-weighted DailyTarget below.
model RepContribution {
  id             String   @id @default(cuid())
  principal      String
  employeeCode   String
  employeeName   String
  teamLeaderId   String?
  quarterRevenue Float
  sharePct       Float
  computedAt     DateTime @default(now())

  @@unique([principal, employeeCode])
  @@index([principal])
}

// Daily Projection — each rep's WeeklyTarget split across weekdays by their own
// productive-visit-count histogram from the preceding calendar week
// (JPAdherenceDetail.productiveFlag), falling back to their trailing-90-day
// histogram, then an even weekday split, if that history is too sparse (same
// layered-fallback shape as JP Adherence's home-day derivation). Persisted
// (unlike the read-time-only rep-level Monthly/Weekly split) because reps need a
// fast "today's number" read and the weekday-weight computation is worth doing
// once rather than per page view. Full-replace per (employeeCode, principal,
// week) whenever the parent WeeklyTarget is saved, and again on each JP
// Adherence sync to roll the preceding-week pattern forward.
model DailyTarget {
  id                String   @id @default(cuid())
  employeeCode      String
  employeeName      String
  principal         String
  teamLeaderId      String
  date              DateTime
  targetValue       Float
  weeklyTargetId    String
  sharePctUsed      Float
  weekdayWeightUsed Float
  createdAt         DateTime @default(now())

  // teamLeaderId is part of the key, not just employeeCode/principal/date — a
  // rep can genuinely be an active assignment under more than one Team Leader
  // for the same principal (e.g. Mars-Nairobi's 5 Team Leaders can share
  // reps), so recomputeDailyTargets (lib/repContribution.ts) can legitimately
  // produce one row per Team Leader for the same rep/principal/day. Confirmed
  // by a real production collision on (employeeCode, principal, date) alone
  // once the updated Roster introduced multiple Team Leaders per principal.
  @@unique([employeeCode, principal, teamLeaderId, date])
  @@index([date])
  @@index([employeeCode, date])
}

// Daily AI-generated executive digest — one row per generation run, produced by
// /api/ai-insights/generate (Claude Sonnet 5) from current Sales-vs-Target and
// Sync Health data, then displayed on /dashboard so it doesn't need
// regenerating on every page view. findings is JSON-serialized
// AiInsightFinding[] (see lib/aiInsights.ts) rather than a relational table —
// a small, display-only structure with no need for independent querying.
model AiInsight {
  id            String   @id @default(cuid())
  generatedAt   DateTime @default(now())
  summary       String
  findings      String // JSON-serialized AiInsightFinding[]
  model         String // the Claude model ID that produced this digest
  periodKind    String   @default("MTD") // PeriodKind from lib/timeIntelligence.ts, matching the top PeriodSelector's selection at generation time
  periodYear    String   @default("")
  periodMonth   String?
  periodToYear  String? // CUSTOM range only
  periodToMonth String? // CUSTOM range only
  principalKey  String? // exact raw Principal string from the Sales dataset, or null for "All Principals"
  cacheKey      String   @default("") // periodKind|year|month|toYear|toMonth|principalKey — exact-match lookup for "is there already a fresh digest for this selection"

  @@index([generatedAt])
  @@index([cacheKey, generatedAt])
}

// Frost conversation history (Phase 3 of the Frost AI agent expansion) — lets
// a user's chat survive a page refresh and gives a plain audit trail, without
// building a heavier memory system than the app actually needs. One
// FrostConversation per chat session; FrostConversationMessage holds the
// individual turns. userId is a plain string (no @relation, matching every
// other cross-model reference in this schema) rather than a Prisma relation —
// ownership is checked in app code (app/api/frost/chat/route.ts) before a
// conversationId from the client is trusted.
model FrostConversation {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

model FrostConversationMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // "user" | "assistant"
  content        String
  createdAt      DateTime @default(now())

  @@index([conversationId, createdAt])
}
